<div id="<%= dom_id article %>" class="flex">
  <div class="w-1/3">
    <%= image_tag article.cover_image %>
  </div>
  <div class="w-2/3 pl-5">
    <p class="my-5">
      <strong class="block font-medium mb-1">Title:</strong>
      <%= link_to article.title, article %>
    </p>

    <p class="my-5">
      <strong class="block font-medium mb-1">Body:</strong>
      <%= article.body %>
    </p>

    <p class="my-5">
      <strong class="block font-medium mb-1">Published at:</strong>
      <%= article.published_at %>
    </p>
  </div>
</div>
