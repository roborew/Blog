<div id="<%= dom_id article %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Title:</strong>
    <%= article.title %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Body:</strong>
    <%= article.body %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Published at:</strong>
    <%= article.published_at %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Cover image:</strong>
    <%= article.cover_image %>
  </p>

</div>
